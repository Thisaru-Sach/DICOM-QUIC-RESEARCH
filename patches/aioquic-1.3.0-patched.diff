+def push_ack_frame(buf: Buffer, rangeset: RangeSet, delay: int, max_ranges: int = 32) -> int:
+    # Bound the number of ranges encoded to keep the frame size predictable
+    # under heavy/bursty loss (many disjoint ranges). RFC 9000 permits
+    # omitting older ranges — receivers primarily need recent loss info;
+    # older gaps are handled by retransmission timers regardless.
+    total   = len(rangeset)
+    ranges  = min(total, max_ranges)
+    start_index = total - ranges
+    index = total - 1
     r = rangeset[index]
     buf.push_uint_var(r.stop - 1)
     buf.push_uint_var(delay)
-    buf.push_uint_var(index)
+    buf.push_uint_var(ranges - 1)
     buf.push_uint_var(r.stop - 1 - r.start)
     start = r.start
-    while index > 0:
+    while index > start_index:
         index -= 1
         r = rangeset[index]
         buf.push_uint_var(start - r.stop - 1)
